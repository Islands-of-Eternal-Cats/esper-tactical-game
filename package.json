{
  "name": "nine-lives-corp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "NINE LIVES CORP — срез «Ржавый»",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "assets": "/Applications/Blender.app/Contents/MacOS/Blender --background --python assets/build-character-kit.py && /Applications/Blender.app/Contents/MacOS/Blender --background --python assets/build-env-kit.py && npm run assets:pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && tsc --noEmit && vitest run",
    "assets:pack": "node scripts/pack-kits.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "gltfpack": "^1.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
